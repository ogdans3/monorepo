---
import { hotell } from '../data/hotell';
import Ikon from './Ikon.astro';
interface Props { tittel?: string; tekst?: string }
const { tittel = 'Bestill oppholdet direkte hos oss', tekst = 'Bestiller du hos oss, får du gratis oppgradering til beste ledige rom ved innsjekk, 50 % rabatt på tredje natt utenfor skoleferiene, og 10 % rabatt på neste opphold.' } = Astro.props;
---
<section class="band morkt">
  <div class="senter band__rute">
    <div>
      <span class="kicker">Bestill direkte, få fordeler</span>
      <h2>{tittel}</h2>
      <p>{tekst} <a href="/overnatting/bestill-direkte/">Les om fordelene.</a></p>
    </div>
    <div class="band__knapper">
      <a class="knapp knapp--fylt" href={hotell.booking} target="_blank" rel="noopener">Se ledige rom <Ikon navn="pil" /></a>
      <a class="knapp" href={`tel:${hotell.telefon.replace(/\s/g, '')}`}><Ikon navn="telefon" /> {hotell.telefonVis}</a>
    </div>
  </div>
</section>
<style>
  .band { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .band__rute { display: grid; gap: 2rem; align-items: center; }
  .band h2 { max-width: 16ch; margin-bottom: 0.9rem; }
  .band p { max-width: 52ch; color: var(--kritt-dempet); }
  .band__knapper { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (min-width: 60rem) { .band__rute { grid-template-columns: 1.4fr 1fr; } .band__knapper { justify-content: end; } }
</style>
