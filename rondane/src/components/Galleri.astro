---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { bilder: ImageMetadata[]; tittel?: string }
const { bilder, tittel = 'Bilder' } = Astro.props;
const store = await Promise.all(bilder.map((b) => getImage({ src: b, width: 1800, format: 'webp' })));
---
{bilder.length > 0 && (
  <section class="galleri" aria-label={tittel}>
    <ul class="galleri__rute">
      {bilder.map((b, i) => (
        <li>
          <a href={store[i].src} data-stort={store[i].src} class="galleri__lenke" aria-label={`Vis bilde ${i + 1} av ${bilder.length} i full størrelse`}>
            <Picture src={b} widths={[320, 640, 960]} sizes="(min-width: 64rem) 24vw, (min-width: 40rem) 46vw, 92vw" formats={['avif', 'webp']} alt="" loading="lazy" decoding="async" />
          </a>
        </li>
      ))}
    </ul>
    <dialog class="galleri__dialog" aria-label="Bilde i full størrelse">
      <button type="button" class="galleri__lukk" aria-label="Lukk">×</button>
      <img alt="" />
    </dialog>
  </section>
)}
<style>
  .galleri__rute { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); }
  .galleri__lenke { display: block; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); background: var(--frost-3); }
  .galleri__lenke :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--kurve); }
  .galleri__lenke:hover :global(img) { transform: scale(1.03); }
  .galleri__dialog { border: 0; padding: 0; background: transparent; max-width: min(96vw, 1600px); max-height: 94vh; }
  .galleri__dialog::backdrop { background: oklch(0.15 0.02 240 / 0.92); }
  .galleri__dialog img { max-width: 96vw; max-height: 94vh; width: auto; height: auto; border-radius: var(--radius); }
  .galleri__lukk { position: fixed; top: 1rem; right: 1rem; width: 3rem; height: 3rem; border-radius: 50%; border: 0; background: var(--frost); color: var(--granitt); font-size: 1.8rem; line-height: 1; cursor: pointer; }
</style>
<script>
  for (const g of document.querySelectorAll<HTMLElement>('.galleri')) {
    const dialog = g.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    g.querySelectorAll<HTMLAnchorElement>('[data-stort]').forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        img.src = a.dataset.stort!;
        dialog.showModal();
      }),
    );
    dialog.querySelector('.galleri__lukk')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }
</script>
