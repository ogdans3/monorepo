---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  bilde?: ImageMetadata;
  alt?: string;
  kicker?: string;
  tittel: string;
  undertittel?: string;
  storrelse?: 'full' | 'halv';
  senter?: boolean;
}
const { bilde, alt = '', kicker, tittel, undertittel, storrelse = 'halv', senter = false } = Astro.props;
---
<header class:list={['hero', `hero--${storrelse}`, { 'hero--uten': !bilde, 'hero--senter': senter }]}>
  {bilde && (
    <div class="hero__bilde">
      <Picture src={bilde} widths={[640, 1024, 1440, 1920, 2400]} sizes="100vw" formats={['avif', 'webp']} alt={alt} loading="eager" fetchpriority="high" decoding="async" />
    </div>
  )}
  <div class="hero__tekst senter">
    {kicker && <span class="kicker">{kicker}</span>}
    <h1>{tittel}</h1>
    {undertittel && <p class="hero__under">{undertittel}</p>}
    <slot />
  </div>
</header>
<style>
  .hero { position: relative; display: grid; align-items: end; background: var(--granitt); color: var(--kritt); overflow: hidden; isolation: isolate; }
  .hero--halv { min-height: clamp(24rem, 52vh, 38rem); }
  .hero--full { min-height: clamp(30rem, 92svh, 60rem); }
  .hero--uten.hero--halv { min-height: 0; padding-top: 7.5rem; }
  .hero__bilde { position: absolute; inset: 0; z-index: -1; }
  .hero__bilde :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* Mørkning nedenfra, så teksten står på granitt uansett hva bildet gjør. */
  .hero__bilde::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, oklch(0.18 0.02 240 / 0.9) 0%, oklch(0.18 0.02 240 / 0.45) 45%, oklch(0.18 0.02 240 / 0.15) 100%); }
  .hero__tekst { width: 100%; padding-top: clamp(6rem, 14vh, 9rem); padding-bottom: clamp(2rem, 5vw, 3.5rem); }
  .hero--senter .hero__tekst { text-align: center; }
  .hero--senter .hero__tekst > * { margin-inline: auto; }
  .hero .kicker { color: var(--fjell-lys); }
  .hero h1 { max-width: 20ch; }
  .hero__under { margin-top: 0.9rem; font-size: clamp(1.1rem, 1rem + 0.6vw, 1.4rem); color: var(--kritt-dempet); max-width: 46ch; }
  .hero--full .hero__under { font-family: var(--skrift-stemme); font-style: italic; font-size: clamp(1.35rem, 1.1rem + 1.2vw, 2.1rem); color: var(--kritt); }
</style>
