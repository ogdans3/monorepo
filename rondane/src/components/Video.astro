---
// YouTube uten å laste YouTube før noen trykker. Plakaten er et stillbilde
// fra hotellet, og selve spilleren hentes først ved klikk — ingen
// informasjonskapsler fra Google på en side ingen har trykket på.
interface Props { id: string; tittel?: string }
const { id, tittel = 'Video' } = Astro.props;
---
<div class="video" data-video={id}>
  <button type="button" class="video__knapp" aria-label={`Spill av: ${tittel}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
    <span class="video__spill" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
  </button>
</div>
<style>
  .video { position: relative; aspect-ratio: 16 / 9; background: var(--granitt); border-radius: var(--radius); overflow: hidden; margin-block: 1.6em; }
  .video__knapp { all: unset; cursor: pointer; display: block; width: 100%; height: 100%; position: relative; }
  .video__knapp:focus-visible { outline: 3px solid var(--fjell-lys); outline-offset: -3px; }
  .video img { width: 100%; height: 100%; object-fit: cover; }
  .video__spill { position: absolute; inset: 0; margin: auto; width: 4.25rem; height: 4.25rem; border-radius: 50%; background: var(--frost); color: var(--granitt); display: grid; place-items: center; transition: transform var(--fart) var(--kurve); }
  .video__spill svg { margin-left: 3px; }
  .video__knapp:hover .video__spill { transform: scale(1.06); }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-video]')) {
    el.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.video}?autoplay=1&rel=0`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      f.title = 'YouTube-video';
      el.replaceChildren(f);
    });
  }
</script>
