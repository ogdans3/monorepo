---
interface Props { smuler: { navn: string; sti: string }[] }
const { smuler } = Astro.props;
---
{smuler.length > 1 && (
  <nav class="smuler senter" aria-label="Du er her">
    <ol>
      {smuler.map((s, i) => (
        <li>{i < smuler.length - 1 ? <a href={s.sti}>{s.navn}</a> : <span aria-current="page">{s.navn}</span>}</li>
      ))}
    </ol>
  </nav>
)}
<style>
  .smuler { padding-block: 1rem 0; font-size: 0.92rem; color: var(--blekk-dempet); }
  .smuler ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 0; }
  .smuler li + li::before { content: '/'; margin-inline: 0.55rem; color: var(--frost-3); }
  .smuler a { color: inherit; text-decoration: none; }
  .smuler a:hover { color: var(--fjell); text-decoration: underline; }
</style>
