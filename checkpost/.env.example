# Copy to .env for local development: cp .env.example .env

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=checkpost
POSTGRES_PASSWORD=checkpost
POSTGRES_DB=checkpost
POSTGRES_PORT=5433

# The API connects with this, from the host and from inside docker compose
# alike. A hosted database (Neon and friends) works for both unchanged. Point it
# at `db` instead of `localhost` only if you run the API inside compose against
# the local container.
DATABASE_URL=postgres://checkpost:checkpost@localhost:5433/checkpost

# The test suite truncates every table between cases, so it gets its own
# database and refuses to run against anything that is not local, or whose name
# does not say "test". See apps/api/test/guard.ts.
TEST_DATABASE_URL=postgres://checkpost:checkpost@localhost:5433/checkpost_test
TEST_ADMIN_DATABASE_URL=postgres://checkpost:checkpost@localhost:5433/postgres

# --- API ----------------------------------------------------------------
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Public origin of the web app. Used to build share links.
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Comma-separated allowed CORS origins. Empty = same-origin only.
CORS_ORIGINS=http://localhost:5173

# How long a list survives with no activity before the reaper deletes it.
# Lists have no owner, so this is the only thing preventing unbounded growth.
LIST_TTL_DAYS=365

# Retention for the per-list change log used by incremental sync.
EVENT_RETENTION_DAYS=14

# --- Web ----------------------------------------------------------------
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
WEB_PORT=5173

# --- Admin dashboard ------------------------------------------------------
# Both unset means /admin does not exist at all, which is the right default for
# anything that is not deliberately an operator console. There is no fallback
# password on purpose.
#   ADMIN_PASSWORD=$(openssl rand -base64 24)
ADMIN_USER=
ADMIN_PASSWORD=
