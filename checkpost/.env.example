# Copy to .env for local development: cp .env.example .env

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=checkpost
POSTGRES_PASSWORD=checkpost
POSTGRES_DB=checkpost
POSTGRES_PORT=5433

# The API connects with this, from the host and from inside docker compose
# alike. A hosted database (Neon and friends) works for both unchanged. Point it
# at `db` instead of `localhost` only if you run the API inside compose against
# the local container.
DATABASE_URL=postgres://checkpost:checkpost@localhost:5433/checkpost

# The test suite truncates every table between cases, so it gets its own
# database and refuses to run against anything that is not local, or whose name
# does not say "test". See apps/api/test/guard.ts.
TEST_DATABASE_URL=postgres://checkpost:checkpost@localhost:5433/checkpost_test
TEST_ADMIN_DATABASE_URL=postgres://checkpost:checkpost@localhost:5433/postgres

# --- API ----------------------------------------------------------------
API_PORT=4000
# Leave unset for local development. On a server that puts a proxy in front,
# set this to the docker bridge gateway (172.17.0.1) so the API is not also
# reachable directly from the internet, around the proxy.
API_BIND=
WEB_BIND=
NODE_ENV=development
LOG_LEVEL=info

# Public origin of the web app. Used to build share links.
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Comma-separated allowed CORS origins. Empty = same-origin only.
CORS_ORIGINS=http://localhost:5173

# How long a list survives with no activity before the reaper deletes it.
# Lists have no owner, so this is the only thing preventing unbounded growth.
LIST_TTL_DAYS=365

# Retention for the per-list change log used by incremental sync.
EVENT_RETENTION_DAYS=14

# --- Read cache -----------------------------------------------------------
# An in-process cache in front of Postgres: token lookups, list snapshots, the
# revision a polling client is asking about. Every write invalidates it in the
# same breath, so nothing needs a clock to stay honest.
#
# Set CACHE_ENABLED=0 for a deployment running more than one API container. One
# instance cannot see the other's writes, and with no expiry nothing would ever
# correct a stale answer.
CACHE_ENABLED=1

# 0 means entries never expire, which is the default and the point: an entry is
# dropped when a write makes it wrong, not when a timer says so. Set a number of
# seconds only to bound how long a change made outside this process can go
# unnoticed.
CACHE_TTL_SECONDS=0

# With no expiry, capacity is the whole eviction policy: full means the least
# recently used entry makes room for the newest. Token lookups, revisions and
# previews are a few dozen bytes each.
CACHE_MAX_ENTRIES=10000

# Snapshots are bounded separately, because one of them is an entire list. A
# 500-item list with long notes can reach a couple of megabytes, so lower this
# if the lists are big. The other caches carry most of the benefit anyway.
CACHE_MAX_SNAPSHOTS=1000

# How often a list's last_active_at may be rewritten. It only decides whether
# the reaper eventually deletes an abandoned list, so writing it on every read
# was a write per read for no extra information.
TOUCH_INTERVAL_SECONDS=600

# --- Web ----------------------------------------------------------------
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
WEB_PORT=5173

# --- Admin dashboard ------------------------------------------------------
# Both unset means /admin does not exist at all, which is the right default for
# anything that is not deliberately an operator console. There is no fallback
# password on purpose.
#   ADMIN_PASSWORD=$(openssl rand -base64 24)
ADMIN_USER=
ADMIN_PASSWORD=
