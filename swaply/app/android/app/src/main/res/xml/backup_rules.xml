<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6 to 11, where `allowBackup="false"` already keeps everything
     out: the same rules again, so that turning backup on for something else
     one day does not bring the session token, the device id or the drafts
     along with it. See the comment on <application> in AndroidManifest.xml. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
