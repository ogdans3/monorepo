# Copy to .env. Read by host tooling — the dev server, migrations, the seed and
# the tests. Docker Compose also reads this file to substitute ${...} in
# docker-compose.yml, which is why the container's database URL is a different
# variable: localhost means something else inside a container.
DATABASE_URL=postgres://swaply:swaply@localhost:5434/swaply

# The tests truncate every table they can reach, so they get their own database.
# `pnpm db:test:setup` creates and migrates it.
TEST_DATABASE_URL=postgres://swaply:swaply@localhost:5434/swaply_test

# Set only to point the deployed API at a database that is not the container
# next door.
# API_DATABASE_URL=postgres://user:pass@host:5432/swaply
PORT=3001
WEB_PORT=5174
PUBLIC_API_ORIGIN=http://localhost:3001
