# Copy to .env. Read by host tooling — the dev server, migrations, the seed and
# the tests. Docker Compose also reads this file to substitute ${...} in
# docker-compose.yml, which is why the container's database URL is a different
# variable: localhost means something else inside a container.
DATABASE_URL=postgres://swaply:swaply@localhost:5434/swaply

# The tests truncate every table they can reach, so they get their own database.
# `pnpm db:test:setup` creates and migrates it.
TEST_DATABASE_URL=postgres://swaply:swaply@localhost:5434/swaply_test

# Set only to point the deployed API at a database that is not the container
# next door.
# API_DATABASE_URL=postgres://user:pass@host:5432/swaply
PORT=3001
WEB_PORT=5174
PUBLIC_API_ORIGIN=http://localhost:3001

# Where the web service talks to the API. The invitation pages are rendered on
# the server, so this is a server-to-server address and never reaches a browser.
API_ORIGIN=http://localhost:3001

# Every invitation link the API mints points at this origin, so it has to be
# where the web app actually answers.
WEB_ORIGIN=http://localhost:5174

# Where «Åpne i Swaply» on an invitation page sends people. In development that
# is `pnpm dev:app`; in a deployment it is the app's own hostname.
PUBLIC_APP_ORIGIN=http://localhost:5175

# The app is invite-only. Off here so a developer can make an account without
# minting a link first; a launch sets it to 1 and `pnpm invite` opens the door.
INVITE_ONLY=0

# Item photographs, on our own disk until the OVH bucket exists. The deployment
# mounts a volume at /data/media; here it is a folder in the working tree, and
# .gitignore keeps it out of the repository.
MEDIA_DIR=./data/media

# Where a client is told to fetch a photograph from. It has to be an address the
# phone or the browser can actually reach — on an Android emulator that is
# http://10.0.2.2:3001, not localhost.
MEDIA_ORIGIN=http://localhost:3001
