{
  "name": "@swaply/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/db/create-test-db.ts && vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "invite": "tsx src/db/invite.ts",
    "db:test:setup": "tsx src/db/create-test-db.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@swaply/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "fastify-plugin": "^6.0.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
