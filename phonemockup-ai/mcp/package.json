{
    "name": "@phonemockup/mcp",
    "version": "0.1.0",
    "private": true,
    "description": "Local MCP server that renders phone mockups with the phonemockup.app 3D scene",
    "type": "module",
    "bin": {
        "phonemockup-mcp": "dist/index.js"
    },
    "files": [
        "dist",
        "harness"
    ],
    "scripts": {
        "build:harness": "cd ../client && node node_modules/vite/bin/vite.js build --config vite.harness.config.ts",
        "build:server": "tsc -p tsconfig.json",
        "build": "npm run build:harness && npm run build:server",
        "start": "node dist/index.js",
        "postinstall": "playwright install chromium"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "ffmpeg-static": "^5.3.0",
        "playwright": "^1.55.1",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/node": "^24.5.2",
        "typescript": "^5.9.2"
    }
}
