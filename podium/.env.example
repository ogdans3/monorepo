# Copy to .env, next to docker-compose.yml, and fill in.

# The one admin password. At least 8 characters; changing it signs every
# session out.
ADMIN_PASSWORD=

# The database's password, inside compose.
POSTGRES_PASSWORD=podium

# Where the app is published on the host. 127.0.0.1 behind a proxy that does
# HTTPS; 0.0.0.0 to reach it from phones on the same network.
APP_BIND=127.0.0.1
APP_PORT=4120

# Uploads bigger than this are refused, in megabytes.
MAX_UPLOAD_MB=500
