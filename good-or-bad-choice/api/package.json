{
  "name": "@good-or-bad-choice/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "postgres": "^3.4.9",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.10",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
