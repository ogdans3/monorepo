# Copy to .env for local development: cp .env.example .env

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=gobc
POSTGRES_PASSWORD=gobc
POSTGRES_DB=gobc
# 5435 because this host already has other projects' databases on 5432, 5433
# and 5434. Every project here runs its own; none of them share one.
POSTGRES_PORT=5435
POSTGRES_BIND=127.0.0.1

# What host tooling connects with: migrations, tests, psql. The container gets
# its own URL from docker-compose.yml, pointing at `db` rather than localhost.
DATABASE_URL=postgres://gobc:gobc@localhost:5435/gobc

# Tests refuse to run against anything that is not local and does not say
# "test" in its name. See api/test/guard.ts.
TEST_DATABASE_URL=postgres://gobc:gobc@localhost:5435/gobc_test

# --- Server ---------------------------------------------------------------
# Development only. The container publishes nothing: the dashboard reaches the
# front door over the aicentral network, per the root README.
PORT=4003
NODE_ENV=development

# Apply pending migrations at boot. On for the container, because nobody is
# going to run one by hand against it.
MIGRATE_ON_BOOT=1
